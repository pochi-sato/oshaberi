#!/usr/bin/env bash
set -euo pipefail

export PATH="${HOME}/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:${PATH:-}"

USER_DISPLAY="${ZUNDASAY_USER:-たくてぃむ}"
CONFIG="${HOME}/.local/share/zundasay/config.json"

INPUT=$(cat)

LOG_DIR="${HOME}/.local/share/zundasay"
LOG="${LOG_DIR}/hook.log"
mkdir -p "$LOG_DIR"
{
  echo "---$(date -Iseconds)---"
  echo "$INPUT"
} >> "$LOG"

EVENT=$(printf '%s' "$INPUT" | jq -r '.hook_event_name // "Stop"')
LAST_MSG=$(printf '%s' "$INPUT" | jq -r '.last_assistant_message // ""')
CWD=$(printf '%s' "$INPUT" | jq -r '.cwd // ""')

PJ_BASENAME=""
if [ -n "$CWD" ]; then
  PJ_PATH=$(echo "$CWD" | sed 's|/\.claude/worktrees/.*||')
  PJ_BASENAME=$(basename "$PJ_PATH" | sed 's/--claude-worktrees-.*//')
fi

PJ_DICT="${HOME}/.local/share/zundasay/project-names.json"
if [ -f "$PJ_DICT" ] && [ -n "$PJ_BASENAME" ]; then
  PJ_NAME=$(jq -r --arg key "$PJ_BASENAME" '.[$key] // $key' "$PJ_DICT" 2>/dev/null || echo "$PJ_BASENAME")
else
  PJ_NAME="${PJ_BASENAME:-くろーど}"
fi

extract_intent() {
  printf '%s' "$1" | python3 -c '
import sys, re
text = sys.stdin.read().rstrip()
m = re.search(r"\[([1-8])\]\s*$", text)
if m:
    print(m.group(1))
' 2>/dev/null || true
}

# [0] mute タグ検出: ユーザーへの音声通知不要 (buddy 中間報告など)
is_muted() {
  printf '%s' "$1" | python3 -c '
import sys, re
text = sys.stdin.read().rstrip()
print("yes" if re.search(r"\[0\]\s*$", text) else "no")
' 2>/dev/null || echo "no"
}

# 全キャラ定義 (= 利用可能なキャラの allowlist。新キャラ追加はここに足す)
ALL_CHAR_NAMES=("ずんだもん" "四国めたん" "春日部つむぎ" "冥鳴ひまり" "もち子さん")
ALL_CHAR_IDS=(3 2 8 14 20)

# config から active_characters を取得して pool 構築
ACTIVE_NAMES=()
ACTIVE_IDS=()
if [ -f "$CONFIG" ]; then
  while IFS= read -r name; do
    [ -z "$name" ] && continue
    for i in "${!ALL_CHAR_NAMES[@]}"; do
      if [ "${ALL_CHAR_NAMES[$i]}" = "$name" ]; then
        ACTIVE_NAMES+=("$name")
        ACTIVE_IDS+=("${ALL_CHAR_IDS[$i]}")
        break
      fi
    done
  done < <(jq -r '(.characters // {}) | to_entries[]? | select(.value == true) | .key' "$CONFIG" 2>/dev/null)
fi

# config が無い / empty なら全キャラ fallback
if [ ${#ACTIVE_NAMES[@]} -eq 0 ]; then
  ACTIVE_NAMES=("${ALL_CHAR_NAMES[@]}")
  ACTIVE_IDS=("${ALL_CHAR_IDS[@]}")
fi

IDX=$(( RANDOM % ${#ACTIVE_NAMES[@]} ))
SPEAKER_NAME="${ACTIVE_NAMES[$IDX]}"
SPEAKER_ID="${ACTIVE_IDS[$IDX]}"

# キャラごとの口調別フレーズ (intent: 1-8)
character_phrase() {
  local char=$1
  local intent=$2
  case "$char" in
    ずんだもん)
      case "$intent" in
        1) echo "質問が来ているのだ" ;;
        2) echo "完了報告が来ているのだ" ;;
        3) echo "相談したいみたいなのだ" ;;
        4) echo "プランを見てほしいみたいなのだ" ;;
        5) echo "進めて良いか聞いているのだ" ;;
        6) echo "問題が起きてるみたいなのだ" ;;
        7) echo "選択肢が出てるのだ" ;;
        *) echo "お知らせが来ているのだ" ;;
      esac
      ;;
    四国めたん)
      case "$intent" in
        1) echo "質問が来てるわ" ;;
        2) echo "完了報告が来てるのよ" ;;
        3) echo "相談したいみたいよ" ;;
        4) echo "プランを見てほしいみたいよ" ;;
        5) echo "進めて良いか聞いてるわ" ;;
        6) echo "問題が起きてるみたいよ" ;;
        7) echo "選択肢が出てるわよ" ;;
        *) echo "お知らせが来てるわ" ;;
      esac
      ;;
    春日部つむぎ)
      case "$intent" in
        1) echo "質問が来てるよ" ;;
        2) echo "完了報告が来たね" ;;
        3) echo "相談したいみたいだよ" ;;
        4) echo "プラン見てほしいって" ;;
        5) echo "進めて良いか聞いてるよ" ;;
        6) echo "問題が起きてるみたいだよ" ;;
        7) echo "選択肢が出てるよ" ;;
        *) echo "お知らせが来てるよ" ;;
      esac
      ;;
    冥鳴ひまり)
      case "$intent" in
        1) echo "質問が来てますよ" ;;
        2) echo "完了報告が来ましたね" ;;
        3) echo "相談したいみたいです" ;;
        4) echo "プランを見てほしいそうです" ;;
        5) echo "進めて良いか聞いてます" ;;
        6) echo "問題が起きてるみたいです" ;;
        7) echo "選択肢が出てますよ" ;;
        *) echo "お知らせが来てますよ" ;;
      esac
      ;;
    もち子さん)
      case "$intent" in
        1) echo "質問が来てますわ" ;;
        2) echo "完了報告が来てますわ" ;;
        3) echo "相談したいみたいですわ" ;;
        4) echo "プランを見てほしいみたいですわ" ;;
        5) echo "進めて良いか聞いてますわ" ;;
        6) echo "問題が起きてるみたいですわ" ;;
        7) echo "選択肢が出てますわ" ;;
        *) echo "お知らせが来てますわ" ;;
      esac
      ;;
    *)
      case "$intent" in
        1) echo "質問が来ているよ" ;;
        2) echo "完了報告が来ているよ" ;;
        3) echo "相談したいみたいだよ" ;;
        4) echo "プランを見てほしいみたいだよ" ;;
        5) echo "進めて良いか聞いているよ" ;;
        6) echo "問題が起きてるみたいだよ" ;;
        7) echo "選択肢が出てるよ" ;;
        *) echo "お知らせが来てるよ" ;;
      esac
      ;;
  esac
}

# Notification (permission_prompt / idle_prompt 等) 用フレーズ
notification_phrase() {
  local char=$1
  local notif_type=$2
  case "$char" in
    ずんだもん)
      case "$notif_type" in
        permission_prompt) echo "許可待ちなのだ" ;;
        idle_prompt) echo "じっとしてるのだ" ;;
        *) echo "お知らせが来ているのだ" ;;
      esac
      ;;
    四国めたん)
      case "$notif_type" in
        permission_prompt) echo "許可待ちよ" ;;
        idle_prompt) echo "じっとしてるわ" ;;
        *) echo "お知らせが来てるわ" ;;
      esac
      ;;
    春日部つむぎ)
      case "$notif_type" in
        permission_prompt) echo "許可待ちだよ" ;;
        idle_prompt) echo "じっとしてるよ" ;;
        *) echo "お知らせが来てるよ" ;;
      esac
      ;;
    冥鳴ひまり)
      case "$notif_type" in
        permission_prompt) echo "許可待ちですよ" ;;
        idle_prompt) echo "じっとしてますよ" ;;
        *) echo "お知らせが来てますよ" ;;
      esac
      ;;
    もち子さん)
      case "$notif_type" in
        permission_prompt) echo "許可待ちですわ" ;;
        idle_prompt) echo "じっとしてますわ" ;;
        *) echo "お知らせが来てますわ" ;;
      esac
      ;;
    *)
      case "$notif_type" in
        permission_prompt) echo "許可待ちだよ" ;;
        idle_prompt) echo "じっとしてるよ" ;;
        *) echo "お知らせが来てるよ" ;;
      esac
      ;;
  esac
}

case "$EVENT" in
  Stop)
    if [ "$(is_muted "$LAST_MSG")" = "yes" ]; then
      exit 0
    fi
    INTENT=$(extract_intent "$LAST_MSG")
    PHRASE=$(character_phrase "$SPEAKER_NAME" "$INTENT")
    msg="${USER_DISPLAY}さん、${PJ_NAME}のくろーどから${PHRASE}"
    ;;
  SubagentStop)
    if [ "$(is_muted "$LAST_MSG")" = "yes" ]; then
      exit 0
    fi
    INTENT=$(extract_intent "$LAST_MSG")
    PHRASE=$(character_phrase "$SPEAKER_NAME" "$INTENT")
    msg="${USER_DISPLAY}さん、サブエージェントから${PHRASE}"
    ;;
  Notification)
    NOTIF_TYPE=$(printf '%s' "$INPUT" | jq -r '.notification_type // ""')
    # idle_prompt は config で off にできる
    if [ "$NOTIF_TYPE" = "idle_prompt" ]; then
      NOTIFY_IDLE=true
      if [ -f "$CONFIG" ]; then
        NOTIFY_IDLE=$(jq -r '.notify_idle // true' "$CONFIG" 2>/dev/null)
      fi
      if [ "$NOTIFY_IDLE" != "true" ]; then
        exit 0
      fi
    fi
    PHRASE=$(notification_phrase "$SPEAKER_NAME" "$NOTIF_TYPE")
    msg="${USER_DISPLAY}さん、${PJ_NAME}のくろーどが${PHRASE}"
    ;;
  *)
    PHRASE=$(character_phrase "$SPEAKER_NAME" "8")
    msg="${USER_DISPLAY}さん、${PJ_NAME}のくろーどから${PHRASE}"
    ;;
esac

nohup env VOICEVOX_SPEAKER="$SPEAKER_ID" zundasay "$msg" </dev/null >/dev/null 2>&1 &
disown 2>/dev/null || true
exit 0
